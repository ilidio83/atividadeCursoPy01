## 14

views = int(input("Quantidade de visualizações: "))
ganho = 0.0
bonus = 0.0

if views <= 10000:
    ganho = 0.0
elif views <= 100000:
    ganho = views * 0.02
elif views <= 1000000:
    ganho = views * 0.03
else:
    ganho = views * 0.05

if views > 500000:
    bonus = 500.0

total = ganho + bonus
print(f"Total a receber: R$ {total:.2f} (Ganhos: R$ {ganho:.2f} + Bônus: R$ {bonus:.2f})")